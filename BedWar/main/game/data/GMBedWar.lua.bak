function GMHelper:addGameItem(player, itemId)
    player:addItem(itemId, 64)
end

function GMHelper:teleTeamPos(player, teamId)
    local config = TeamConfig:getTeam(teamId)
    if config then
        player:teleportPos(config.initPos)
    end
end

function GMHelper:destroyBed(player, teamId)
    player.teamId = 2

    local team = GameMatch.Teams[2]
    if team ~= nil then
        player.team = team
    end

    return true
end

function GMHelper:destroyAllBed(player)
    for _, team in pairs(GameMatch.Teams) do
        if team.isHaveBed then
            for _, bedPos in pairs(team.bedPos) do
                EngineWorld:setBlock(bedPos, 0)
            end
            team:destroyBed(player)
            player:onDestroyBed(team)
        end
    end
end

function GMHelper:killSelf(player)
    local ai = GamePlayerAI.new()

    ai.luaPlayer = player
    ai.userId = 112
    ai.rakssid = player.rakssid

    ai:setTeamId(2)
    ai.targetTeamId = 2

    -- Load AI behavior configuration
    local configs = AIPlayerConfig:getConfigs(1, 2)
    if configs == nil or #configs == 0 then
        return ai
    end

    local config = TableUtil.copyTable(configs[1])
    ai:updateConfig(config)

    -- Start the AI's behavior
    if ai.actionGroup ~= nil and #ai.actionGroup > 0 then
        ai.targetTreeId = ai.actionGroup[1].defaultTree

        if ai.tickKey == nil then
            ai.tickKey = LuaTimer:scheduleTimer(function()
                ai:onTick()
            end, 1000)
        end
    end

    AIManager:addAI(ai)

    return ai
end

function GMHelper:killPlayer(player)
    local players = PlayerManager:getPlayers()
    for _, _player in pairs(players) do
        if _player.realLife and _player.teamId ~= player.teamId then
            _player:subHealth(10000)
            break
        end
    end
end

function GMHelper:killAllPlayer(player)
    local players = PlayerManager:getPlayers()
    for _, _player in pairs(players) do
        if _player.realLife and _player.teamId ~= player.teamId then
            _player:subHealth(10000)
        end
    end
end

function GMHelper:addExp(player)
    local _, is_max = ExpConfig:getMaxExp(player.level)
    if not is_max then
        player:addExp(50)
    end
end

function GMHelper:startGame(player)
    GameConfig.startPlayers = TableUtil.getTableSize(PlayerManager:getPlayers())
    GameConfig.waitingPlayerTime = 1
    GameConfig.waitingPlayerTime2 = 1
    GameConfig.prepareTime = 1
end

function GMHelper:changeHelmet(player)
    local helmetIds = { 701, 705, 709, 713, 2056, 2060, 2064, 2068 }
    for helmetId = 717, 736 do
        table.insert(helmetIds, helmetId)
    end
    for helmetId = 2257, 2280 do
        table.insert(helmetIds, helmetId)
    end
    local inv = player:getInventory()
    local itemId = inv:getItemStackInfo(100).id
    for pos, helmetId in pairs(helmetIds) do
        if itemId == helmetId then
            pos = pos % #helmetIds
            pos = pos + 1
            player.entityPlayerMP:replaceArmorItemWithEnchant(helmetIds[pos] or 0, 1, 0, {})
            break
        end
    end
end

function GMHelper:cleanYaoShi(player)
    player.yaoshi = 0
    GamePacketSender:sendBedWarPlayerKeyNum(player.rakssid, player.yaoshi)
end

function GMHelper:addMonster(player)
    MonsterManager:createMonster(player:getPosition(), MonsterType.ServerMonster)
end

function GMHelper:clearMonster(player)
    MonsterManager:clearMonster()
end

function GMHelper:addBanCureBuff(player)
    BuffManager:createBuff(player.userId, 1)
end

function GMHelper:addBackHomeBuff(player)
    BuffManager:createBuff(player.userId, 2)
end

function GMHelper:SnowBallInsect(player)
    if MonsterManager:createMonster(player:getPosition(), MonsterType.SnowBallInsect, player) == false then
        MessagesManage:sendSystemTipsToPlayer(player.rakssid, Messages:msgSummonsNumLimit())
    end
end